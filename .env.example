# Overrides opcionais pro docker-compose.yml. Sem este arquivo, os valores
# default (dev-only, nao usar fora de local) sao usados.
POSTGRES_USER=upa_user
POSTGRES_PASSWORD=upa_password
POSTGRES_DB=upa_nordeste

# Credenciais do administrador criado automaticamente no primeiro boot do backend.
ADMIN_MATRICULA=000001
ADMIN_PIN=1234
ADMIN_NOME=Admin Sistema
